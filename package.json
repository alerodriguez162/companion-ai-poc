{
  "name": "companion-ai-poc",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @companion/web dev",
    "dev:api": "pnpm --filter @companion/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @companion/api db:migrate",
    "db:seed": "pnpm --filter @companion/api db:seed",
    "eval": "python evals/conversation-simulator/simulate.py"
  }
}
