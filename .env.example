# Application
LOG_LEVEL=info
DEBUG_PROMPT_LOGGING=false

# API (Node)
API_PORT=3001
AI_SERVICE_URL=http://localhost:8000
DATABASE_URL=postgresql://companion:companion@localhost:5432/companion

# Web
WEB_PORT=5173
VITE_API_BASE_URL=
CORS_ORIGIN=*

# AI service (Python)
AI_PORT=8000
LLM_TIMEOUT_SECONDS=120
EMBEDDING_DIMENSIONS=1024

# Local llama.cpp OpenAI-compatible server
# On Windows/macOS, prefer a native llama.cpp server and point LLM_BASE_URL at it.
LLM_BASE_URL=http://localhost:8080
LLM_MODEL_PATH=./models/model.gguf
LLM_CONTEXT_SIZE=8192
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# Conversation / memory (used in later phases)
RECENT_MESSAGE_LIMIT=20
MEMORY_EXTRACTION_INTERVAL=10
MEMORY_RETRIEVAL_LIMIT=8
MEMORY_SCORE_SIMILARITY_WEIGHT=0.65
MEMORY_SCORE_IMPORTANCE_WEIGHT=0.25
MEMORY_SCORE_RECENCY_WEIGHT=0.10

# Postgres (docker compose)
POSTGRES_USER=companion
POSTGRES_PASSWORD=companion
POSTGRES_DB=companion
POSTGRES_PORT=5432
